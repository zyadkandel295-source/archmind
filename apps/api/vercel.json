{
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "storage/ai-base/**",
        "node_modules/pdfkit/js/standard-fonts/**"
      ]
    },
    "api/file-worker.ts": {
      "includeFiles": [
        "storage/ai-base/**",
        "node_modules/pdfkit/js/standard-fonts/**"
      ],
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "archmind-file-generation",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
